{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  mode: 'onboarding',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'schedule:weekly',
  ],
  configMigration: true,
  enabledManagers: [
    'github-actions',
    'gomod',
    'npm',
    'dockerfile',
  ],
  branchPrefix: 'renovate/',
  separateMajorMinor: false,
  minimumReleaseAge: '5 days',
  semanticCommits: 'enabled',
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    semanticCommitType: 'fix',
  },
  packageRules: [
    {
      matchCategories: [
        'docker',
      ],
      managerFilePatterns: [
        '/(^|/)Dockerfile$/',
      ],
      pinDigests: true,
    },
    {
      matchPackageNames: [
        '*',
      ],
      groupName: 'dependencies',
      semanticCommitType: 'chore',
    },
    {
      matchManagers: [
        'gomod',
      ],
      postUpdateOptions: [
        'gomodUpdateImportPaths',
      ],
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepNames: [
        'go',
      ],
      matchDepTypes: [
        'golang',
        'toolchain',
      ],
      groupName: 'golang',
      rangeStrategy: 'bump',
      schedule: [
        'at any time',
      ],
      minimumReleaseAge: '0',
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepNames: [
        'go',
      ],
      matchDepTypes: [
        'golang',
      ],
      matchUpdateTypes: [
        'patch',
        'major',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      groupName: 'Docker images',
      automerge: true,
    },
    {
      matchManagers: [
        'npm',
      ],
      groupName: 'npm packages',
      automerge: true,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'GitHub Actions',
      automerge: true,
    },
  ],
}
